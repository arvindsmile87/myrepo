<mxGraphModel page="1" pageWidth="1660" pageHeight="2390" grid="1" gridSize="10">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="&lt;b&gt;Member Enrollment | Technical execution and service interactions&lt;/b&gt;&lt;br&gt;FHIR R4 • Member-fhir-api • Logical design for engineering review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#18324B;fontSize=22;spacing=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1580" height="75" as="geometry" />
    </mxCell>
    <mxCell id="pre" value="&lt;b&gt;Business prerequisite: Client Setup&lt;/b&gt;&lt;br&gt;Organization / OrganizationAffiliation / InsurancePlan exist in target tenant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C6A34D;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="110" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="source" value="&lt;b&gt;1. API client → Kong API Gateway&lt;/b&gt;&lt;br&gt;POST /fhir/member; tenant ID header; Patient + Coverage collection Bundle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="255" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="pre" target="source">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="gate" value="&lt;b&gt;2. Member FHIR API — pre-processing&lt;/b&gt;&lt;br&gt;Content-Type application/json or application/fhir+json; resourceType=Bundle; type=collection; meta.tag.code=enrollment; API IG validation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="400" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="source" target="gate">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="structure" value="&lt;b&gt;3. Bundle Structure Gate&lt;/b&gt;&lt;br&gt;At least one entry; only Patient / Coverage; validate entry structure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="545" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="gate" target="structure">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="field" value="&lt;b&gt;4. Field Validation&lt;/b&gt;&lt;br&gt;Patient.birthDate: ISO date, 1910 to today; SSN format: 9 digits (requiredness per IG). Coverage MB identifier &amp;gt;5 chars; dependent code 1–2 chars; policyHolder and payor required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="690" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="structure" target="field">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="identity" value="&lt;b&gt;5. Identity Enrichment&lt;/b&gt;&lt;br&gt;@coupe/identifier-resolver resolves or creates canonical identity; stamps coupeId and resource.id; selects POST/PUT using identity registry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="835" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="field" target="identity">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="plan" value="&lt;b&gt;6. InsurancePlan Lookup&lt;/b&gt;&lt;br&gt;Coverage.policyHolder, group/division and period.start; search tenant HealthLake; match plan dates and group/division extensions. Require exactly one match." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="980" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="identity" target="plan">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="coverage" value="&lt;b&gt;7. Coverage lifecycle — meeting update&lt;/b&gt;&lt;br&gt;Prior Coverage lookup and applicable continuity/termination rules. Exact execution position and transaction boundaries require confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C6A34D;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1125" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="plan" target="coverage">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="refs" value="&lt;b&gt;8. Reference Validation&lt;/b&gt;&lt;br&gt;Coverage.beneficiary, policyHolder, payor and class plan extension; validate literal ResourceType/id reference format." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1270" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="coverage" target="refs">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="stamp" value="&lt;b&gt;9. Profile Stamping&lt;/b&gt;&lt;br&gt;stampPersistProfiles(): add persistence URLs alongside API profiles in meta.profile; set Bundle.type=transaction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1415" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="refs" target="stamp">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="proxy" value="&lt;b&gt;10. FHIR Proxy Service&lt;/b&gt;&lt;br&gt;Persist-profile, identity-method and HAPI validation; signed request to AWS HealthLake." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#537CA5;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1560" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="stamp" target="proxy">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="store" value="&lt;b&gt;11. AWS HealthLake&lt;/b&gt;&lt;br&gt;Persist Patient and Coverage in selected tenant FHIR R4 datastore." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#63956C;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1705" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="proxy" target="store">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="response" value="&lt;b&gt;12. Return processing response&lt;/b&gt;&lt;br&gt;Propagate proxy response status to caller; exact response body per response design." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#63956C;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="1850" width="760" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#53677A;fontSize=12;" edge="1" parent="1" source="store" target="response">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="tenant" value="&lt;b&gt;Tenant context&lt;/b&gt;&lt;br&gt;Request header selects datastore. Header name and authorization enforcement to verify." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C6A34D;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="255" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="validator" value="&lt;b&gt;fhir-validation-service&lt;/b&gt;&lt;br&gt;Validate incoming API IG profiles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#8995A1;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="400" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="manager" value="&lt;b&gt;identifier-manager-api&lt;/b&gt;&lt;br&gt;Canonical identity registry; matching precedence to verify." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#8995A1;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="835" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="lookup" value="&lt;b&gt;HealthLake lookup&lt;/b&gt;&lt;br&gt;Existing InsurancePlan; in-process cache. Prior Coverage lookup discussed separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#8995A1;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="980" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="pending" value="&lt;b&gt;Plan Enrichment — NOT IMPLEMENTED&lt;/b&gt;&lt;br&gt;Pending Coverage IG extensions. Not part of active execution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C6A34D;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="1125" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e1" value="&lt;b&gt;400 / 415 / 422&lt;/b&gt;&lt;br&gt;Bad request, unsupported media type or validation failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B65B55;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="1250" y="400" width="360" height="110" as="geometry" />
    </mxCell>
    <mxCell id="e2" value="&lt;b&gt;422&lt;/b&gt;&lt;br&gt;Invalid fields or zero/multiple plan matches; reference validation failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B65B55;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="1250" y="980" width="360" height="110" as="geometry" />
