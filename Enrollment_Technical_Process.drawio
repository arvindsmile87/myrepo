    <mxCell id="read" value="&lt;b&gt;Separate read path — documented API endpoints&lt;/b&gt;&lt;br&gt;GET /fhir/member/Patient/{fhirId} or GET /fhir/member/Coverage/{fhirId} → tenant-scoped retrieval → response. Internal read-service chain and bulk extraction design require confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#8995A1;fontColor=#18324B;fontSize=15;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="430" y="2030" width="760" height="135" as="geometry" />
    </mxCell>
